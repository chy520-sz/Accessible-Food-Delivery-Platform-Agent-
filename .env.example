# ============================================================
#  take-out Agent 环境变量模板 —— 复制为 .env 后按需填写
#  注意：不要用本模板直接覆盖已有 .env，以免丢失真实凭据
# ============================================================

# ===== 对话模型：继续使用现有 DeepSeek =====
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_REQUEST_TIMEOUT=120

# ===== 百炼嵌入：新增（与语音凭据是两套 Key，需分别填写）=====
DASHSCOPE_API_KEY=填写你的百炼API密钥
# 按百炼控制台中的地域和业务空间填写
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
RAG_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
RAG_EMBEDDING_DIMENSIONS=1024
RAG_EMBEDDING_BATCH_SIZE=10
RAG_EMBEDDING_TIMEOUT=30

# ===== Milvus：新增（本地 Docker Standalone）=====
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_DB_NAME=default
RAG_COLLECTION_FOOD=takeout_dish_qwen37_1024_v1
RAG_COLLECTION_DIETARY=takeout_dietary_qwen37_1024_v1
RAG_COLLECTION_FAQ=takeout_faq_qwen37_1024_v1
RAG_TOP_K=8
# COSINE 相似度下限，需用评测问题校准
RAG_MIN_SCORE=0.25

# ===== Java 后端 =====
JAVA_BASE_URL=http://localhost:3000
# 必须与 Java 后端 application.yml 的 agent.api-key 保持一致
AGENT_API_KEY=change-me-in-production

# ===== 本地 Agent =====
AGENT_HOST=127.0.0.1
AGENT_PORT=8000
AGENT_RELOAD=false
# 客户端调用 /agent/* 的服务密钥；本地调试可留空，生产建议由 Java/网关注入
AGENT_SERVICE_API_KEY=
AGENT_MAX_TTS_CHARS=2000
AGENT_CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
# SSL 证书校验默认开启；仅在确有内网自签证书问题时设为 false
SSL_VERIFY=true
# 单轮运行预算（recursion_limit 为图步数上限，不等价旧 max_iterations）
AGENT_RECURSION_LIMIT=25
AGENT_MAX_TOOL_CALLS=10
AGENT_MAX_MODEL_CALLS=12
AGENT_TOTAL_TIMEOUT_SECONDS=115
AGENT_MESSAGE_WINDOW=24

# ===== Agent 评测轨迹（不记录原文、工具入参/结果或用户身份） =====
EVAL_TRACE_ENABLED=true
EVAL_TRACE_PATH=./data/agent_traces.jsonl

# ===== 分层长期记忆 =====
MEMORY_ENABLED=true
MEMORY_DB_PATH=./data/agent_memory.db
# 外部知识引用不会写入用户记忆，而是进入此 RAG 审核收件箱
MEMORY_RAG_INBOX_PATH=./data/rag_reference_inbox.jsonl
MEMORY_RETRIEVAL_TOP_K=6
MEMORY_STALE_DAYS=180

# ===== 需要语音识别时填写（纯文本联调可暂不配置）=====
# 获取步骤参考阿里云智能语音交互文档 https://help.aliyun.com/document_detail/72138.html
ALIYUN_ACCESS_KEY_ID=你的AccessKeyId
ALIYUN_ACCESS_KEY_SECRET=你的AccessKeySecret
ALIYUN_ASR_APP_KEY=你的Appkey
