# ==================== 阿里云智能语音交互凭据（必填） ====================
# 获取步骤（共 4 步，约 5 分钟）：
#
# 第 1 步：注册阿里云账号并完成个人实名认证
#   https://account.aliyun.com
#
# 第 2 步：创建 AccessKey
#   登录 RAM 控制台 → 身份管理 → 用户 → 创建用户
#   → 勾选"OpenAPI 调用访问" → 下载保存 AccessKey ID 和 Secret
#   https://ram.console.aliyun.com/users
#
# 第 3 步：开通智能语音交互服务
#   访问产品页 → 点击"开通并购买"
#   新用户可享 3 个月免费试用（2 路并发）
#   https://ai.aliyun.com/nls
#
# 第 4 步：创建项目获取 Appkey
#   登录智能语音交互控制台 → 创建项目 → 选择"仅语音识别"
#   → 获取 Appkey
#   https://nls-portal.console.aliyun.com
#
# 参考文档: https://help.aliyun.com/document_detail/72138.html

ALIYUN_ACCESS_KEY_ID=你的AccessKeyId
ALIYUN_ACCESS_KEY_SECRET=你的AccessKeySecret
ALIYUN_ASR_APP_KEY=你的Appkey

# ==================== 大模型配置（DeepSeek）====================
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ==================== Java 后端地址 ====================
JAVA_BASE_URL=http://localhost:3000

# ==================== Agent 调 Java 后端专用 Key ====================
# 生产环境请改为复杂随机字符串，并与 Java 后端 Agent 接口校验配置保持一致
AGENT_API_KEY=change-me-in-production

# ==================== Agent 服务端口 ====================
AGENT_PORT=8000
AGENT_HOST=0.0.0.0
